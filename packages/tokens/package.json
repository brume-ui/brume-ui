{
  "name": "@brume-ui/brume-tokens",
  "version": "0.1.0-alpha.13",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/brume-ui/brume-ui",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "MOTION.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./motion-theme.css": "./dist/motion-theme.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "homepage": "https://github.com/brume-ui/brume-ui#readme",
  "bugs": {
    "url": "https://github.com/brume-ui/brume-ui/issues"
  }
}
