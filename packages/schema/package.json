{
  "name": "@herb09638/brume-schema",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/herb09638/brume-ui",
    "directory": "packages/schema"
  },
  "files": [
    "dist",
    "schema",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/v0.json": "./schema/v0.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && pnpm emit-schema",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "emit-schema": "tsx scripts/emit-json-schema.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15"
  }
}
