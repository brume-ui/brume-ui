{
  "name": "@brume-ui/brume-inertia",
  "version": "0.1.0-alpha.10",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/brume-ui/brume-ui",
    "directory": "packages/inertia"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && pnpm build:css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify"
  },
  "dependencies": {
    "@brume-ui/brume-react": "workspace:*",
    "@brume-ui/brume-renderer": "workspace:*",
    "@brume-ui/brume-schema": "workspace:*",
    "@inertiajs/react": "2.3.29"
  },
  "devDependencies": {
    "@brume-ui/brume-tokens": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "homepage": "https://github.com/brume-ui/brume-ui#readme",
  "bugs": {
    "url": "https://github.com/brume-ui/brume-ui/issues"
  }
}
